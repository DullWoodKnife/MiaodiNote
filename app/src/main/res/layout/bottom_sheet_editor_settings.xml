<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FF1E1E1E">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="#FF555555" />

    <!-- 三个标签：快捷栏 / 编辑器设置 / 文本格式 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tabQuick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="快捷栏"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tabEditor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="编辑器设置"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tabFormat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="文本格式"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ============ 快捷栏 ============ -->
    <LinearLayout
        android:id="@+id/panelQuick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/qbTab"
                style="@style/EditorQuickBtn"
                android:text="-&gt;|" />

            <TextView
                android:id="@+id/qbHeading"
                style="@style/EditorQuickBtn"
                android:text="H" />

            <TextView
                android:id="@+id/qbBold"
                style="@style/EditorQuickBtn"
                android:text="B"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/qbItalic"
                style="@style/EditorQuickBtn"
                android:text="I"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/qbQuote"
                style="@style/EditorQuickBtn"
                android:text="&gt;" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/qbImage"
                style="@style/EditorQuickBtn"
                android:text="&#128444;" />

            <TextView
                android:id="@+id/qbOl"
                style="@style/EditorQuickBtn"
                android:text="1." />

            <TextView
                android:id="@+id/qbUl"
                style="@style/EditorQuickBtn"
                android:text="*." />

            <TextView
                android:id="@+id/qbLink"
                style="@style/EditorQuickBtn"
                android:text="&#127760;" />

            <TextView
                android:id="@+id/qbCode"
                style="@style/EditorQuickBtn"
                android:text="&lt;/&gt;" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/qbTask"
                style="@style/EditorQuickBtn"
                android:text="-[ ]" />

            <TextView
                android:id="@+id/qbInlineCode"
                style="@style/EditorQuickBtn"
                android:text="`" />

            <TextView
                android:id="@+id/qbStrike"
                style="@style/EditorQuickBtn"
                android:text="~~" />

            <TextView
                android:id="@+id/qbMath"
                style="@style/EditorQuickBtn"
                android:text="$" />

            <TextView
                android:id="@+id/qbTable"
                style="@style/EditorQuickBtn"
                android:text="+" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ 编辑器设置 ============ -->
    <LinearLayout
        android:id="@+id/panelEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLineSpacing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="文本行距:12"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/seekLineSpacing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:progressTint="#FFFFC107"
            android:thumbTint="#FFFFC107" />

        <CheckBox
            android:id="@+id/cbSyncScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#FFFFFFFF"
            android:text="同步滑动"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/cbWysiwyg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#FFFFFFFF"
            android:text="所见即所得模式"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/cbWritingMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#FFFFFFFF"
            android:text="写作模式"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/cbFocusMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#FFFFFFFF"
            android:text="专注模式"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- ============ 文本格式 ============ -->
    <LinearLayout
        android:id="@+id/panelFormat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/fmtAddBlankLine"
            style="@style/EditorFormatRow"
            android:text="增加段落后一行空格" />

        <TextView
            android:id="@+id/fmtRemoveBlankLine"
            style="@style/EditorFormatRow"
            android:text="移除段落后一行空格" />

        <TextView
            android:id="@+id/fmtIndentFirstLine"
            style="@style/EditorFormatRow"
            android:text="段落首行加入空格" />

        <TextView
            android:id="@+id/fmtRemoveIndent"
            style="@style/EditorFormatRow"
            android:text="移除段落首行空格" />

        <TextView
            android:id="@+id/fmtCjkSpace"
            style="@style/EditorFormatRow"
            android:text="中英文之间加入空格" />

        <TextView
            android:id="@+id/fmtCjkNumSpace"
            style="@style/EditorFormatRow"
            android:text="中文数字之间加入空格" />
    </LinearLayout>
</LinearLayout>
